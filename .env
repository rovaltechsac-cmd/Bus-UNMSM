APP_NAME="Bus UNMSM"
APP_ENV=production
APP_KEY=base64:51s806AOUvrwe6wa2oMF0K3Bc/WBWpOA2v3Z8gl3StU=
APP_DEBUG=false
APP_URL=https://kipucloud.com/BusUNMSM
APP_SUBDIRECTORY=/BusUNMSM

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos SQLite editable: se crea desde database/base.sqlite si no existe.
DB_CONNECTION=sqlite
DB_DATABASE=database/app.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

BUS_VELOCIDAD_PROMEDIO_KMH=15
BUS_RADIO_PARADERO_M=40
BUS_INACTIVO_MINUTOS=2
